{
  "manifest": "854_156383",
  "stories": [
    {
      "id": "FruitTreeUnlock1",
      "dialogues": [
        {
          "id": 0,
          "lines": [
            {
              "role_id": 840200,
              "text": "命运之树已经汲取满了能量，是时候揭开篷布了！",
              "voice_event_key": "chapter_2_guide_12_01",
              "voice_file": "Home/FruitTreeAudio/938386590.ogg"
            }
          ]
        },
        {
          "id": 1,
          "lines": [
            {
              "role_id": 840200,
              "text": "看~命运果实都长出来了，这可是超级实用的果实。",
              "voice_event_key": "chapter_2_guide_12_02",
              "voice_file": "Home/FruitTreeAudio/1021417715.ogg"
            },
            {
              "role_id": 840200,
              "text": "我们把命运果实全摘下来。",
              "voice_event_key": "chapter_2_guide_12_03",
              "voice_file": "Home/FruitTreeAudio/144477445.ogg"
            }
          ]
        },
        {
          "id": 2,
          "lines": [
            {
              "role_id": 840200,
              "text": "这棵树上会定期结出命运果实。",
              "voice_event_key": "chapter_2_guide_12_04",
              "voice_file": "Home/FruitTreeAudio/549777862.ogg"
            },
            {
              "role_id": 840200,
              "text": "命运果实可以在世界中使用，探索出各种奇奇怪……哦不，奇妙的东西！",
              "voice_event_key": "chapter_2_guide_12_05",
              "voice_file": "Home/FruitTreeAudio/324522175.ogg"
            },
            {
              "role_id": 840200,
              "text": "等你下次出门探索的时候，我们再试一下~",
              "voice_event_key": "chapter_2_guide_12_06",
              "voice_file": "Home/FruitTreeAudio/1028634612.ogg"
            }
          ]
        }
      ]
    },
    {
      "id": "FruitTreeUnlock2",
      "dialogues": [
        {
          "id": 0,
          "lines": [
            {
              "role_id": 840200,
              "text": "命运之树的二期施工完成啦，快拆除挡板看看吧！",
              "voice_event_key": "chapter_2_guide_15_01",
              "voice_file": "Home/FruitTreeAudio/123627960.ogg"
            }
          ]
        },
        {
          "id": 1,
          "lines": [
            {
              "role_id": 840200,
              "text": "树上挂满了祈求幻兽的红绳，接下来就能够进行幻兽结缘了。",
              "voice_event_key": "chapter_2_guide_15_02",
              "voice_file": "Home/FruitTreeAudio/975353190.ogg"
            }
          ]
        }
      ]
    }
  ],
