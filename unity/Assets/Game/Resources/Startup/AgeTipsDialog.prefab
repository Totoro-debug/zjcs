  m_text: "1\u3001\u672C\u6E38\u620F\u662F\u4E00\u6B3E\u96BE\u5EA6\u9002\u4E2D\u7684\u653E\u7F6E\u5192\u9669\u7C7B\u6E38\u620F\uFF0C\u9002\u7528\u4E8E\u5E74\u6EE116\u5468\u5C81\u53CA\u4EE5\u4E0A\u7684\u7528\u6237\uFF0C\u5EFA\u8BAE\u672A\u6210\u5E74\u4EBA\u5728\u5BB6\u957F\u76D1\u62A4\u4E0B\u4F7F\u7528\u6E38\u620F\u4EA7\u54C1\u3002\n2\u3001\u672C\u6E38\u620F\u57FA\u4E8E\u67B6\u7A7A\u7684\u6545\u4E8B\u80CC\u666F\u548C\u4E16\u754C\u89C2\uFF0C\u7ED3\u5408\u5E7B\u60F3\u5192\u9669\u5143\u7D20\uFF0C\u753B\u98CE\u6E05\u65B0\u660E\u5FEB\uFF0C\u5185\u5BB9\u5065\u5EB7\u5411\u4E0A\u3002\u73A9\u5BB6\u901A\u8FC7\u626E\u6F14\u4E3B\u89D2\uFF0C\u4E00\u65B9\u9762\u7ECF\u8425\u95F2\u9002\u7684\u5BB6\u56ED\u751F\u6D3B\uFF0C\u53E6\u4E00\u65B9\u9762\u63A2\u7D22\u672A\u77E5\u7684\u5947\u5E7B\u4E16\u754C\u3002\u6E38\u620F\u4E2D\u6709\u57FA\u4E8E\u6587\u5B57\u7684\u964C\u751F\u4EBA\u793E\u4EA4\u7CFB\u7EDF\uFF0C\u793E\u4EA4\u7CFB\u7EDF\u7684\u7BA1\u7406\u9075\u5FAA\u76F8\u5173\u6CD5\u5F8B\u6CD5\u89C4\u3002\n3\u3001\u672C\u6E38\u620F\u5DF2\u63A5\u5165\u56FD\u5BB6\u5B9E\u540D\u8BA4\u8BC1\u7CFB\u7EDF\uFF0C\u5FC5\u987B\u4F7F\u7528\u771F\u5B9E\u6709\u6548\u8EAB\u4EFD\u4FE1\u606F\u8FDB\u884C\u6E38\u620F\u8D26\u53F7\u6CE8\u518C\u5E76\u767B\u5F55\u7F51\u7EDC\u6E38\u620F\uFF0C\u672A\u901A\u8FC7\u5B9E\u540D\u8BA4\u8BC1\u7684\u7528\u6237\u4E0D\u53EF\u8FDB\u5165\u6E38\u620F\u3002\u4E3A\u4E25\u683C\u843D\u5B9E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u7684\u8981\u6C42\uFF0C\u8BA4\u8BC1\u4E3A\u672A\u6210\u5E74\u4EBA\u7684\u7528\u6237\u5C06\u65E0\u6CD5\u8FDB\u884C\u6E38\u620F\u3002\n4\u3001\u672C\u6E38\u620F\u4EE5\u6302\u673A\u517B\u6210\u548C\u5730\u56FE\u63A2\u7D22\u4E3A\u4E3B\u8981\u73A9\u6CD5\uFF0C\u5F15\u5BFC\u73A9\u5BB6\u5408\u7406\u5B89\u6392\u65F6\u95F4\uFF0C\u83B7\u53D6\u8F7B\u677E\u8212\u9002\u7684\u4F53\u9A8C\u3002"
