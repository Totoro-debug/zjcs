# Local development tools
.tools/

# Local render outputs, logs, and scratch files
output/*
tmp/*
__pycache__/

# Local build and validation outputs
/build/
/Build/
/Builds/
/unity/Build/
/unity/Builds/
/unity/output/

# Independent asset pack payloads; code and compact pack metadata stay in Git.
/assets/official/
/assets/characters/
/assets/reference/*
!/assets/reference/SOURCES.md
!/assets/reference/LEGACY_SOURCES.md
!/assets/reference/application-icon-source-manifest.json

# Keep pack archives and complete file inventories out of Git at any location.
zjcs-assets-*.zip
zjcs-assets-*.zip.manifest.json
_asset-pack-manifest.json
# Keep the single documentation index, feature/map pages and asset guide in Git.
/docs/*
!/docs/features/
!/docs/maps/
!/docs/README.md
!/docs/asset-management.md

# Local code navigation index.
/.codegraph/

# Unity project: keep source, settings and stable .meta files; exclude local caches.
/unity/Library/
/unity/Temp/
/unity/Obj/
/unity/Logs/
/unity/UserSettings/
/unity/MemoryCaptures/
/unity/Recordings/
/unity/.vs/
/unity/.idea/
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/*.user
/unity/*.pidb
/unity/*.booproj
/unity/Assets/Official/*
!/unity/Assets/Official/.gitkeep
!/unity/Assets/Official/World/
!/unity/Assets/Official/World/Map/
!/unity/Assets/Official/World/Map/14/
!/unity/Assets/Official/World/Map/14/NativeEntityMaterials/
!/unity/Assets/Official/World/Map/14/NativeEntityTextures/
!/unity/Assets/Official/World/Map/14/NativeEntityPrefabs/
!/unity/Assets/Official/World/Map/14/NativeEntityPrefabs/**
!/unity/Assets/Official/ApplicationIcon.meta
!/unity/Assets/Official/ApplicationIcon/
!/unity/Assets/Official/ApplicationIcon/**
